# Sistem Data Survey Seismik - versi sederhana

survey = {
    "Survey_A": [
        {"trace_id": 1, "receiver": "R1", "offset": 100, "QC_flag": "OK"},
        {"trace_id": 2, "receiver": "R2", "offset": 150, "QC_flag": "OK"},
        {"trace_id": 3, "receiver": "R3", "offset": 200, "QC_flag": "BAD"}
    ],
    "Survey_B": [
        {"trace_id": 4, "receiver": "R1", "offset": 120, "QC_flag": "OK"},
        {"trace_id": 5, "receiver": "R4", "offset": 250, "QC_flag": "OK"},
        {"trace_id": 6, "receiver": "R2", "offset": 300, "QC_flag": "BAD"}
    ],
    "Survey_C": [
        {"trace_id": 7, "receiver": "R5", "offset": 180, "QC_flag": "OK"}
    ]
}

print("=== Program Survey Seismik ===")

# 1. Tampilkan trace_id yang QC_flag BAD
print("\nTrace ID dengan QC_flag = BAD:")
for nama in survey:
    for trace in survey[nama]:
        if trace["QC_flag"] == "BAD":
            print(trace["trace_id"])

# 2. Hitung total trace
total_trace = 0
for nama in survey:
    total_trace += len(survey[nama])

print("\nTotal trace:", total_trace)

# 3. Cari survey dengan trace paling banyak
max_trace = 0
survey_terbanyak = ""

for nama in survey:
    jumlah = len(survey[nama])
    if jumlah > max_trace:
        max_trace = jumlah
        survey_terbanyak = nama

print("\nSurvey dengan trace terbanyak:", survey_terbanyak)

# 4. Buat set receiver unik
receiver_unik = set()

for nama in survey:
    for trace in survey[nama]:
        receiver_unik.add(trace["receiver"])

print("\nReceiver unik:")
print(receiver_unik)

# 5. Hitung jumlah kemunculan tiap receiver
hitung_receiver = {}

for nama in survey:
    for trace in survey[nama]:
        r = trace["receiver"]
        if r in hitung_receiver:
            hitung_receiver[r] += 1
        else:
            hitung_receiver[r] = 1

print("\nJumlah trace tiap receiver:")
print(hitung_receiver)
