# program konversi suhu sederhana (1 file aja)

print("Program Konversi Suhu")

print("1. Celcius ke Fahrenheit")
print("2. Fahrenheit ke Celcius")

pilih = input("Pilih menu (1/2): ")

if pilih == "1":
    c = float(input("Masukkan suhu Celcius: "))
    hasil = (c * 9/5) + 32
    print("Hasil:", hasil, "F")

elif pilih == "2":
    f = float(input("Masukkan suhu Fahrenheit: "))
    hasil = (f - 32) * 5/9
    print("Hasil:", hasil, "C")

else:
    print("Pilihan nggak sesuai")
